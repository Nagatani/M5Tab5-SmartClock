{
  "build": {
    "arduino": {
      "ldscript": "esp32p4_out.ld",
      "memory_type": "opi_opi"
    },
    "core": "esp32",
    "extra_flags": [
      "-DARDUINO_ESP32_P4",
      "-DARDUINO_M5STACK_TAB5",
      "-DBOARD_HAS_PSRAM"
    ],
    "f_cpu": "400000000L",
    "f_flash": "80000000L",
    "flash_mode": "dio",
    "mcu": "esp32p4",
    "variant": "esp32p4"
  },
  "connectivity": [
    "wifi",
    "bluetooth"
  ],
  "debug": {
    "openocd_target": "esp32p4.cfg"
  },
  "frameworks": [
    "arduino",
    "espidf"
  ],
  "name": "M5Stack Tab5 (ESP32-P4)",
  "upload": {
    "flash_size": "16MB",
    "maximum_ram_size": 33554432,
    "maximum_size": 16777216,
    "require_upload_port": true,
    "speed": 921600
  },
  "url": "https://docs.m5stack.com",
  "vendor": "M5Stack"
}
